# --- R / environment
.Rhistory
.Rproj.user/
.RData
.Renviron
*.Rproj
*.pkl

# --- Stan
*.rds.stan        # occasionally left behind
stan_cache/

# --- LaTeX aux
*.aux
*.log
*.out
*.toc
*.blg
*.bbl
*.nav
*.snm
*.vrb
*.fdb_latexmk
*.fls
texput.log

# --- OS / editor
.DS_Store
.vscode/
.idea/
*~
*.swp

# --- Outputs we don't want in the repo
# Large Stan fits and figs — regenerable, take a lot of space.
# Intermediate data (subsets) are reproducible from scripts.
fits/**/*.rds
figs/**/*.png
# Compiled cmdstanr binaries (Mach-O/ELF sitting next to the .stan) — never commit:
# a macOS binary rsynced to a Linux cluster silently crashes every chain.
studies/**/stan/*
!studies/**/stan/
!studies/**/stan/*.stan
# Regenerable study figures that live outside a figs/ dir
studies/bayes_long/*.png
# But keep the directories themselves so scripts don't have to mkdir
!fits/.gitkeep
!figs/.gitkeep
!figs/**/.gitkeep
# And keep the pulled raw data — these need wordbankr/childesr (R >= 4.4
# and mysql headers) which Sherlock's R 4.2 can't handle. Commit the
# intermediate files so Sherlock can skip those packages.
!fits/long_items.rds
!fits/english_word_freq.rds
!fits/norwegian_word_freq.rds
# Also keep the prepared Stan bundles — small (~few MB each), and they
# need raw inputs (e.g., the 875 MB BabyView transcripts) that aren't
# on Sherlock. Building them once locally and committing avoids that.
!fits/long_subset_data.rds
!fits/long_subset_data_nor.rds
!fits/babyview_subset_data.rds
!fits/subset_data.rds
!fits/peekbank_subset_data.rds
!fits/seedlings_subset_data.rds
!fits/stanford_linked_subset_data.rds
!fits/io_am2018_subset_data.rds
!fits/io_fmw2013_subset_data.rds
!fits/io_pooled_subset_data.rds

# Compiled Stan model objects (auto-generated)
model/*.rds
model/stan/*.rds
model/stan/*.rds.stan
# cmdstanr also compiles a binary alongside the .stan source with no
# extension (e.g. model/stan/log_irt_long for log_irt_long.stan).
# Ignore those binaries; the !*.stan negation keeps source tracked.
model/stan/log_irt
model/stan/log_irt_*
!model/stan/log_irt*.stan

# Local-only pre-refactor stuff
model/log_irt.rds
model/log_irt.stan
model/log_irt_v2.rds
model/log_irt_v2.stan

# Scratch / tmp logs
*.log.gz
/tmp_*

# --- Raw data (huge CSVs, kept locally only) ---
data/raw/babyview/merged_transcripts_parsed.csv
# Smaller files (video metadata, CDI items) are tracked.

# --- Local-only credentials and config
# Anything matching .env* except the example template.
.env
.env.local
.env.*.local
!.env.example
# Per-user secrets dir
secrets/

# --- Optional: the large Wordbank preprocessed file that the original
# standard_model codebase uses. Keep it for convenience on dev; Sherlock
# users can regenerate it via preprocess_word_freq.R.
# (Uncomment if you want to keep it out of the repo entirely.)
# standard_model/scripts/data/engWS_preprocessed.Rdata
# Exclude transient .claude contents, but keep project-specific skills
.claude/settings.local.json
.claude/.DS_Store
.claude/worktrees/
.claude/sessions/
.positai

# Feng eval partial-training snapshots (overwritten frequently; only final committed)
fits/feng_eval/seed*_partial.csv

# LaTeX build artifacts from the standalone docs in reports/
reports/**/*.aux
reports/**/*.log
reports/**/*.out

# --- Office lock files
~$*
.claude/scheduled_tasks.lock
cluster/sherlock/glmer_ladder_manifest.csv

# Quarto auto-generated render artifacts
paper/input_paper.pdf
paper/input_paper.tex
paper/input_paper_cache/
paper/input_paper_files/
paper/full_supplemental.pdf
paper/full_supplemental.tex
paper/full_supplemental.html
paper/full_supplemental_cache/
paper/full_supplemental_files/
# Retired papers archive: tracked files stay tracked; hide the archived
# untracked render debris (old knitr caches, .docx renders) it absorbed.
paper/old/

# Stray default R plot dumps
Rplots.pdf
**/Rplots.pdf

# SEEDLings raw EyeLink reports (816MB; RT derived by prepare_seedlings_lwl_rt.R)
data/raw/seedlings/raw_eyetracking_data/

# --- Repo-hygiene: regenerable build artifacts / raw archives ---
# Raw BabyView CDI download archive (the extracted data_june_2026/ dir is tracked)
data/raw/babyview/data_june_2026-*.zip
# Local run logs
logs/
# Rendered Quarto/doc outputs (sources tracked; render artifacts ignored —
# see the paper/input_paper* block above)
studies/llm/llm_experiments.html
studies/llm/llm_experiments_files/
# cmdstan per-chain draw CSVs (regenerable Stan sampler output)
fits/csvs_*/
# Editor/script backups (*.rds.*bak is covered below; this catches script .bak/.bak2)
*.bak
*.bak[0-9]
# Stray dated .rds backups
*.rds.*bak

# Harmonized CDI union (47MB; regenerable via model/scripts/build_harmonized_cdi.R;
# duplicates the tracked per-study *_cdi_items_long.csv). Small harmonized artifacts ARE tracked.
data/harmonized/cdi_item_level.csv

# --- Credentials: never commit ---
# Redivis API token and any other per-repo secrets. `secrets/` (a directory) was already
# ignored; `.secrets` (a file) was not, so an `git add -A` would have swept the token in.
.secrets
.secrets.*
*.token
